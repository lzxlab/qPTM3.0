# qPTM Agent Backend Configuration

# LLM API (OpenCode Go — OpenAI-compatible) — used by the chat agent
# Bare model id for the HTTP API (not "provider/model").
DEEPSEEK_API_KEY=sk-your-opencode-api-key-here
DEEPSEEK_BASE_URL=https://opencode.ai/zen/go/v1
# Zen endpoint for models not on Go (gpt-5, gemini-*, claude-*)
DEEPSEEK_ZEN_BASE_URL=https://opencode.ai/zen/v1
DEEPSEEK_MODEL=deepseek-flash
# Tried in order after DEEPSEEK_MODEL fails (timeout / empty / model error)
DEEPSEEK_FALLBACK_MODELS=deepseek-v4-flash,glm-5.2,deepseek-v4-pro

# qPTM REST API. This host's :80 vhost 301s to https://qptm3.omicsbio.info,
# so http://127.0.0.1/api is not a same-box shortcut — keep the public origin
# unless you add an internal vhost that serves /api without redirect.
QPTM_API_BASE_URL=https://qptm3.omicsbio.info/api

# External database APIs (no auth required)
UNIPROT_API_BASE_URL=https://rest.uniprot.org
IPTMNET_API_BASE_URL=https://research.bioinformatics.udel.edu/iptmnet/api
ACTIVEDRIVER_API_BASE_URL=https://activedriverdb.org

# PPI APIs (STRING / BioGRID / IntAct)
# Prefer cn.string-db.org — string-db.org may be Cloudflare-blocked from some hosts
STRING_API_BASE_URL=https://cn.string-db.org/api
BIOGRID_API_BASE_URL=https://webservice.thebiogrid.org
# Free key: https://webservice.thebiogrid.org/
BIOGRID_ACCESS_KEY=
INTACT_API_BASE_URL=https://www.ebi.ac.uk/Tools/webservices/psicquic/intact/webservices/current/search

# Pathway APIs / data
REACTOME_API_BASE_URL=https://reactome.org/ContentService
KEGG_API_BASE_URL=https://rest.kegg.jp
PATHBANK_DATA_DIR=./data/pathways/PathBank

# Domain / family APIs (InterPro hosts both InterPro + Pfam)
INTERPRO_API_BASE_URL=https://www.ebi.ac.uk/interpro/api

# eKPI Quantitative matrices (large per-site *.csv.gz; not copied into data/)
EKPI_DATA_DIR=/var/www/html/ekpi
EKPI_FINAL_RESULT_DIR=/var/www/html/ekpi/final_result

# Local data directories — by PTM research aspect (see data/README.md)
ENZYMES_DATA_DIR=./data/enzymes
PSP_DATA_DIR=./data/regulation/phosphositeplus
FUNCSCORE_DATA_DIR=./data/regulation/Funcscore
PTMINT_DATA_DIR=./data/interactions/PTMint
STABILITY_DATA_DIR=./data/stability/curated
PTMPHASE_DATA_DIR=./data/phase_separation/ptmphase
DSCOP_DATA_DIR=./data/phase_separation/dscope
DBPTM_DATA_DIR=./data/disease/dbptm
ACTIVEDRIVER_DATA_DIR=./data/disease/ActiveDriverDB
PTMD_DATA_DIR=./data/disease/PTMD
PMADS_DATA_DIR=./data/drug/PMADS
DRUGBANK_DATA_DIR=./data/drug/DrugBank
DECRYPTM_DATA_DIR=./data/drug/decryptM
PROTEOMICSDB_API_BASE_URL=https://www.proteomicsdb.org
INULOC_DATA_DIR=./data/localization/iNuLoC
COMPARTMENTS_DATA_DIR=./data/localization/COMPARTMENTS
LOCALIZATION_DATA_DIR=./data/localization
CONVERSATIONS_DATA_DIR=./runtime/conversations

# Collection Agent (literature-mining pipeline)
COLLECTION_AGENT_DIR=../collection-agent
COLLECTION_JOBS_DIR=../collection-agent/runtime/collection/jobs
COLLECTION_NODE_BIN=/opt/node22/bin/node
COLLECTION_MAX_UPLOAD_BYTES=52428800
# pi-ai provider/model (overrides collection-agent/.env MODEL when set)
COLLECTION_MODEL=opencode-go/deepseek-flash
COLLECTION_FALLBACK_MODELS=opencode-go/deepseek-v4-flash,opencode-go/glm-5.2,opencode-go/deepseek-v4-pro
UNPAYWALL_EMAIL=you@example.com
# NCBI_API_KEY=
# NCBI_EMAIL=you@example.com
QPTM3_GET_URL_DIR=../collection-agent/scripts

# Literature enrichment for tool evidence (Python tools layer)
LITERATURE_ENRICHMENT_ENABLED=true
LITERATURE_ABSTRACT_LIMIT=5

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost,http://qptm3.omicsbio.info,https://qptm3.omicsbio.info
