# Preferred: OpenCode Go subscription (OpenAI-compatible API)
# Get key: https://opencode.ai/auth  → subscribe Go → copy API key
OPENCODE_API_KEY=sk-your-opencode-key-here
MODEL=opencode-go/deepseek-flash
# Tried after MODEL fails (provider/model ids)
MODEL_FALLBACKS=opencode-go/deepseek-v4-flash,opencode-go/glm-5.2,opencode-go/deepseek-v4-pro

# Required by Unpaywall API (use a real contact email)
UNPAYWALL_EMAIL=you@example.com

# Optional: NCBI E-utilities (Stage 1 abstract fetch via PubMed)
# https://www.ncbi.nlm.nih.gov/account/settings/ → API Key Management
# NCBI_API_KEY=your-ncbi-api-key
# NCBI_EMAIL=you@example.com
# NCBI_TOOL=qPTM-CollectionAgent
